# OpenRouter - optional. Only ":free"-suffixed models are ever used (enforced
# in app/llm_engine.py) so triage can never incur cost.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mock triage engine (fallback when OpenRouter is unavailable)
LLM_MOCK_SEVERITY_THRESHOLD=7

# DFIR-IRIS
IRIS_BASE_URL=https://iris.local
IRIS_API_KEY=
IRIS_CUSTOMER_ID=3
IRIS_VERIFY_SSL=false

# Webhook
WAZUH_WEBHOOK_TOKEN=

# Decision log (leave default for local dev; in docker-compose this points
# into the mounted volume so the evaluation dataset survives restarts)
DATABASE_URL=sqlite+aiosqlite:///./siemantics.db
