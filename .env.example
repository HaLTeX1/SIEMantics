# OpenRouter - optional. Only "openrouter/free" (auto-routes to a currently
# available free model) or a ":free"-suffixed model are ever used (enforced in
# app/llm_engine.py) so triage can never incur cost.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Pin one or more free models (comma-separated, first = primary, rest = fallbacks in order) after
# measuring them with: python -m app.eval_replay. openrouter/free picks a different model per call.

# Max seconds for one OpenRouter call (1 retry); on timeout the alert is retried later
OPENROUTER_TIMEOUT_SECONDS=60

# Mock triage engine (fallback when OpenRouter is unavailable)
LLM_MOCK_SEVERITY_THRESHOLD=7

# A false positive verdict with confidence below this (0-1) is not suppressed
# but marked needs_review for an analyst (no IRIS case is opened)
REVIEW_CONFIDENCE_THRESHOLD=0.7
# Prompt injection safety net: at or above this Wazuh level the LLM cannot
# suppress an alert - a false positive verdict goes to needs_review instead
REVIEW_SEVERITY_FLOOR=12
# The LLM's own confidence did not tell right from wrong verdicts in production, so a false positive
# verdict is suppressed automatically only when analysts labeled at least HISTORY_MIN_AGREEMENT alerts
# of the same rule false positive (and none true positive), or the second opinion agrees; otherwise
# needs_review. A true positive verdict that analysts keep contradicting also goes to needs_review.
REQUIRE_FP_CORROBORATION=true
HISTORY_MIN_AGREEMENT=2
# Optional second free model for uncorroborated false positive verdicts (costs quota). Empty = off.
SECOND_OPINION_MODEL=

# DFIR-IRIS
IRIS_BASE_URL=https://iris.local
IRIS_API_KEY=
IRIS_CUSTOMER_ID=3
IRIS_VERIFY_SSL=false
# Every this many seconds, cases closed directly in IRIS are picked up and their
# outcome (TP / FP / legitimate) becomes the alerts' disposition. 0 = disabled.
IRIS_SYNC_INTERVAL_SECONDS=120
# Optional: public URL of this app, so IRIS cases link back to the alert record
# (e.g. http://10.64.0.x:8000)
SIEMANTICS_PUBLIC_URL=
# Correlation window in hours (0 = disabled). Within it, similar alerts (same rule
# or MITRE technique) from the same source IP are added to the existing IRIS case
# instead of opening a new one, and up to CORRELATION_MAX_ALERTS earlier alerts
# from the same host / source IP are shown to the LLM as context.
CORRELATION_WINDOW_HOURS=24
# Alerts without a source IP (FIM, user/group changes, ...) join the open case of
# the same host within this many minutes, so one action does not open several
# cases. Wazuh manager (agent 000) alerts are excluded. 0 = disabled.
CORRELATION_HOST_WINDOW_MINUTES=10
CORRELATION_MAX_ALERTS=10
# Repeated alerts (same host, rule and normalized key fields) within this many hours
# skip the LLM and take over the earlier decision; repeats of an alert an analyst
# labeled false positive are suppressed. 0 = disabled.
DEDUP_WINDOW_HOURS=24
# Flood guard: once one rule fires FLOOD_THRESHOLD times on the same host within
# FLOOD_WINDOW_MINUTES, further alerts skip the LLM and take over the latest decision
# for that rule and host (unless their level is higher). 0 = disabled.
FLOOD_THRESHOLD=20
FLOOD_WINDOW_MINUTES=10

# IoC enrichment - optional, skipped per-provider if its key is unset. Only
# runs for escalated (true-positive) alerts, capped to a few unique IPs.
# Free keys: https://www.virustotal.com/gui/my-apikey / https://www.abuseipdb.com/account/api
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ENRICHMENT_MAX_IOCS=5

# Webhook - shared secret, must equal <api_key> in the Wazuh <integration> block
# (wazuh/ossec-integration.xml). If empty, anyone can post alerts (a warning is logged).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WAZUH_WEBHOOK_TOKEN=
# Alerts in these Wazuh rule groups are stored only as context for triaging other alerts
# (no LLM, no IRIS case), e.g. package installs that explain user/group/systemd changes.
CONTEXT_RULE_GROUPS=dpkg,yum
# Seconds to wait after an alert arrives before triage, so the rest of a burst is there as context.
TRIAGE_SETTLE_SECONDS=30
# When the LLM is unavailable (quota, rate limit, outage) alerts wait and retry instead of a
# rule-based guess; after this many hours they go to needs_review for an analyst.
LLM_RETRY_MAX_HOURS=6
# Host inventory sync from the Wazuh API (OS, IP, groups, listening services), in minutes. 0 = manual only.
HOST_SYNC_INTERVAL_MINUTES=60

# Alerts in these Wazuh rule groups (comma-separated) are dropped by the webhook: not stored,
# not triaged, no IRIS case. Default "sca" = configuration benchmarks (CIS etc.). Empty = keep all.
IGNORED_RULE_GROUPS=sca

# Wazuh manager API for response actions (one-click IP block from an alert). Empty URL = disabled.
# Use a dedicated API user that may only run active responses and read agents (see README).
# The manager also needs the <active-response> blocks from wazuh/ossec-active-response.xml.
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_API_VERIFY_SSL=false
# Wazuh indexer (OpenSearch) for the events around an alert (prompt context and timeline). Empty URL = off.
# The indexer listens on 127.0.0.1 by default. Easiest: go through the Wazuh dashboard's console proxy
# (no change on the Wazuh server): WAZUH_INDEXER_URL=https://<dashboard host> and WAZUH_INDEXER_VIA_DASHBOARD=true.
# Use a read-only indexer user, not admin (see README).
WAZUH_INDEXER_URL=
WAZUH_INDEXER_VIA_DASHBOARD=false
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_VERIFY_SSL=false
WAZUH_INDEXER_INDICES=wazuh-alerts-4.x-*
# Minutes before and after the alert, and the maximum number of events given to the LLM.
SURROUNDING_MINUTES=10
SURROUNDING_MAX_EVENTS=25

# Automatic IP block after triage escalated a brute force alert from a public, low-reputation address.
# off | dry_run (default: only records what it would have blocked) | enforce. Watch dry_run for a few days first.
AUTO_BLOCK_MODE=dry_run
AUTO_BLOCK_RULE_GROUPS=authentication_failures
# Minimum AbuseIPDB confidence score (0 = not required); looked up if the enrichment has none.
AUTO_BLOCK_MIN_ABUSE_SCORE=90
# 1, 24 or 168 hours. agent = on the attacked host; all = every active agent (needed for manager-relayed alerts).
AUTO_BLOCK_DURATION_HOURS=1
AUTO_BLOCK_SCOPE=agent
AUTO_BLOCK_MAX_PER_HOUR=10
# After a successful automatic block, close the case as "true positive without impact" in IRIS and SIEMantics,
# if it only holds brute force alerts and the Wazuh indexer shows no successful login from the IP in the
# lookback window before the block. These labels are marked automatic and never used as analyst verdicts.
AUTO_CLOSE_AFTER_BLOCK=true
AUTO_CLOSE_SUCCESS_LOOKBACK_HOURS=24
# Older open brute force-only cases without an assignee are closed the same way when the IP is blocked or the
# attack has been quiet for AUTO_CLOSE_STALE_HOURS, with no successful login since. off | dry_run (default: only
# lists them on the System status tab, where "Close now" approves it) | enforce.
AUTO_CLOSE_MODE=dry_run
AUTO_CLOSE_STALE_HOURS=24
AUTO_CLOSE_SWEEP_MINUTES=30
# Agent installer (Admin > Agent install): manager address the agents use (empty: the WAZUH_API_URL host) and the
# agent version (empty: the Wazuh API version). The command points at SIEMANTICS_PUBLIC_URL (or the admin page's
# address), which the hosts must reach.
WAZUH_MANAGER_ADDRESS=
WAZUH_AGENT_VERSION=
# Host isolation: addresses that stay reachable (the Wazuh manager IP from WAZUH_API_URL is added automatically
# when it is an IP) and agent names that can never be isolated (e.g. SIEMantics, IRIS, domain controller).
RESPONSE_ISOLATION_ALLOW=
RESPONSE_PROTECTED_HOSTS=
# Extra IPs / networks (comma-separated) that can never be blocked, on top of every
# non-public address and the IRIS / Wazuh / SIEMantics hosts (e.g. your own public IPs).
RESPONSE_PROTECTED_NETWORKS=

# Alerts triaged in parallel by the background workers. 1 = one at a time: easiest
# on the OpenRouter free-tier rate limit, and correlation sees earlier decisions.
TRIAGE_WORKERS=1

# Dashboard users. On startup, if the users table is empty, the first admin is
# created from ADMIN_USERNAME/ADMIN_PASSWORD (min. 8 chars recommended). Further
# users are created by that admin on the /ui/admin.html panel. Changing these
# values later does NOT change an existing admin's password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
# Automatic IP ban after failed logins (0 = off): MAX failures within WINDOW minutes ban the address
# for BAN minutes, doubled for repeat offenders up to BAN_MAX.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_BAN_MINUTES=30
LOGIN_BAN_MAX_MINUTES=1440
# Behind a reverse proxy / Cloudflare Tunnel: the proxy's (cloudflared's) IP or network. Only requests from
# here may carry the real client IP in CF-Connecting-IP / X-Forwarded-For. The System status tab shows the
# address to put here once a forwarded request arrives.
TRUSTED_PROXY_IPS=
# Addresses that are never banned (e.g. your own workstation), comma-separated, CIDR allowed.
LOGIN_BAN_EXEMPT=
# Set to true when the UI is served over HTTPS (e.g. behind a reverse proxy)
SESSION_COOKIE_SECURE=false

# Decision log / evaluation dataset storage.
# Plain `python -m venv` local dev: leave DATABASE_URL on the SQLite default below.
# docker-compose: point it at an external MySQL/MariaDB server - a SQLite file
# inside the container does not survive a rebuild. The database and user must
# exist already (tables are created automatically on startup); URL-encode
# special characters in the password (e.g. @ -> %40).
#   DATABASE_URL=mysql+aiomysql://siemantics:PASSWORD@db-host:3306/siemantics
DATABASE_URL=sqlite+aiosqlite:///./siemantics.db
