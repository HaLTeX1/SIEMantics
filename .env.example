# OpenAI - optional. If left empty, or if a call fails (quota, timeout, ...),
# triage automatically falls back to the built-in rule-based mock engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mock triage engine (fallback when OpenAI is unavailable) - Wazuh severity
# level at/above which an alert is flagged as a true positive.
LLM_MOCK_SEVERITY_THRESHOLD=7

# DFIR-IRIS
IRIS_BASE_URL=https://iris.local
IRIS_API_KEY=
IRIS_CUSTOMER_ID=3

# Webhook
WAZUH_WEBHOOK_TOKEN=

# Decision log (leave default for local dev; in docker-compose this points
# into the mounted volume so the evaluation dataset survives restarts)
DATABASE_URL=sqlite+aiosqlite:///./siemantics.db
