<group name="suricata,siemantics,">
  <rule id="110599" level="0">
    <if_sid>110575</if_sid>
    <field name="src_ip">^10\.64\.0\.127$</field>
    <field name="src_port">^8000$</field>
    <description>Suricata: attack-response signature on SIEMantics own HTTP response (feedback loop, suppressed)</description>
  </rule>
  <rule id="110597" level="0">
    <if_sid>110575</if_sid>
    <field name="src_ip">^10\.64\.0\.95$</field>
    <field name="src_port">^3000$</field>
    <description>Suricata: attack-response signature on Forgejo serving repository content (suppressed)</description>
  </rule>
</group>
